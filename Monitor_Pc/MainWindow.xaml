<Window x:Class="Monitor_Pc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Monitor_Pc.ViewModels"
        xmlns:converters="clr-namespace:Monitor_Pc.Converters"
        mc:Ignorable="d"
        Title="MONITOR PRO v4.0" Height="900" Width="1300"
        Background="#08080C" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCiano"       Color="#00F2FF"/>
        <SolidColorBrush x:Key="AccentPurple"      Color="#BC00FF"/>
        <SolidColorBrush x:Key="AccentOrange"      Color="#FF9E00"/>
        <SolidColorBrush x:Key="AccentRed"         Color="#FF3D00"/>
        <SolidColorBrush x:Key="AccentGreen"       Color="#00E676"/>
        <SolidColorBrush x:Key="AccentYellow"      Color="#FFE57F"/>
        <SolidColorBrush x:Key="CardBackground"    Color="#12121A"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#0A0A0F"/>

        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <BooleanToVisibilityConverter         x:Key="BoolToVis"/>

        <!-- Converter for inverse bool: shows diagnostic panel only when HWiNFO is NOT active -->
        <Style x:Key="DiagPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HwInfoActive}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush"     Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="20"/>
            <Setter Property="Margin"          Value="0,0,20,20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3300F2FF"/>
                    <Setter Property="Background"  Value="#161622"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#44FFFFFF"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SensorName" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#BFFFFFFF"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth"          Value="210"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SensorValue" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#55FFFFFF"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10FFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TBtnClose" BasedOn="{StaticResource TBtn}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,50,28,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                        <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Ellipse Width="48" Height="48" Fill="{StaticResource AccentPurple}" Opacity="0.15"/>
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="{StaticResource AccentCiano}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="MONITOR" FontSize="22" FontWeight="Black"/>
                        <TextBlock Text="CORE ENGINE v4" FontSize="11" Foreground="#44FFFFFF" FontWeight="Bold" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,30">
                        <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="5,0,0,14"/>
                        <Border Background="#12FFFFFF" CornerRadius="14" Padding="18,14"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentCiano}" VerticalAlignment="Center"/>
                                <TextBlock Text="Live Status" Margin="16,0,0,0" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Stats (only when HWiNFO active) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20"
                                Visibility="{Binding HwInfoActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="READINGS" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="5,0,0,12"/>
                        <Border Background="#08FFFFFF" CornerRadius="14" Padding="18,12"
                                BorderBrush="#10FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalReadings}" FontSize="28" FontWeight="Black"
                                           Foreground="{StaticResource AccentCiano}" HorizontalAlignment="Center"/>
                                <TextBlock Text="sensores ativos" FontSize="10" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#08FFFFFF" CornerRadius="14" Padding="18,12"
                                BorderBrush="#10FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding LastUpdate}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="última leitura" FontSize="10" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ⚠️ Diagnostic panel — shows ONLY when HWiNFO is not connected -->
                    <Border Grid.Row="3" Style="{StaticResource DiagPanel}"
                            Margin="0,0,0,20" Padding="18,16" CornerRadius="16"
                            Background="#1AFF9E00" BorderBrush="#44FF9E00" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                                <TextBlock Text="  DIAGNÓSTICO" FontSize="10" FontWeight="Black"
                                           Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DiagnosticMessage}"
                                       FontSize="11" Foreground="#CCFF9E00"
                                       TextWrapping="Wrap" LineHeight="18"/>
                            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="10"
                                    Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
                                <TextBlock FontSize="10" Foreground="#AAFFFFFF" TextWrapping="Wrap" LineHeight="16">
                                    <Run FontWeight="Bold" Foreground="#FFFFFF">Como corrigir:</Run>
                                    <LineBreak/>
                                    1. Abra o HWiNFO64
                                    <LineBreak/>
                                    2. Clique no ícone de engrenagem (Settings)
                                    <LineBreak/>
                                    3. Aba "General"
                                    <LineBreak/>
                                    4. Marque "Shared Memory Support"
                                    <LineBreak/>
                                    5. Clique OK
                                    <LineBreak/>
                                    6. Feche e reabra os Sensores
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Data source indicator -->
                    <Border Grid.Row="4" Padding="20,18" CornerRadius="20"
                            Background="#08FFFFFF" BorderBrush="#08FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DATA SOURCE" FontSize="9" FontWeight="Black" Foreground="#33FFFFFF" Margin="0,0,0,10"/>

                            <!-- HWiNFO active -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HwInfoActive, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00E676" BlurRadius="12" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="HWiNFO64 ATIVO" Margin="12,0,0,0" FontSize="12"
                                           FontWeight="Black" Foreground="{StaticResource AccentGreen}"/>
                            </StackPanel>

                            <!-- Fallback -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HwInfoActive}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                                <TextBlock Text="MODO FALLBACK" Margin="12,0,0,0" FontSize="12"
                                           FontWeight="Black" Foreground="{StaticResource AccentOrange}"/>
                            </StackPanel>

                            <!-- Last update (always visible) -->
                            <TextBlock Text="{Binding LastUpdate}" FontSize="11"
                                       Foreground="#33FFFFFF" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ═══ MAIN ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="#08080C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#10FFFFFF" Height="32"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="MONITOR PRO v4.0" FontSize="11" Foreground="#44FFFFFF"
                           VerticalAlignment="Center" Margin="25,0,0,0" FontWeight="Bold" IsHitTestVisible="False"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource TBtn}"      Content="─"/>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource TBtn}"      Content="▢"/>
                    <Button x:Name="BtnClose"    Click="BtnClose_Click"    Style="{StaticResource TBtnClose}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- Header bar -->
            <Border Grid.Row="1" Padding="50,30,50,40" Background="#02FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Performance Hub" FontSize="32" FontWeight="SemiBold"/>
                        <TextBlock FontSize="14" Foreground="#44FFFFFF" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="HWiNFO64 · dados em tempo real · todos os sensores"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HwInfoActive}" Value="False">
                                            <Setter Property="Text" Value="Modo fallback · ative o Shared Memory no HWiNFO64"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="22,12" Margin="0,0,14,0" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CpuLoad}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentPurple}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="22,12" Margin="0,0,14,0" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TEMP" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding MaxTemp}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentRed}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="22,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding RamUsage}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentCiano}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ SENSOR CARDS ════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="40,10,20,40">
                <ItemsControl ItemsSource="{Binding HardwareItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card header -->
                                    <Border Background="#06FFFFFF" CornerRadius="20,20,0,0"
                                            Padding="22,16" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <Ellipse Width="38" Height="38" Fill="{StaticResource AccentCiano}" Opacity="0.08"/>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                           Foreground="{StaticResource AccentCiano}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sensor groups -->
                                    <Border Grid.Row="1" Padding="22,16">
                                        <StackPanel>

                                            <!-- LOADS -->
                                            <StackPanel Visibility="{Binding HasLoads, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                <TextBlock Text="CARGA / USO" Style="{StaticResource GroupLabel}"/>
                                                <ItemsControl ItemsSource="{Binding Loads}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,10,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SensorName}" FontSize="9" Foreground="#55FFFFFF"/>
                                                                    <ProgressBar Value="{Binding ValuePercentage}" Height="3"
                                                                                 Background="#0AFFFFFF" Foreground="{StaticResource AccentPurple}"
                                                                                 BorderThickness="0" Margin="0,3,0,2"/>
                                                                    <ProgressBar Value="{Binding LinkedSensor.ValuePercentage}" Height="2"
                                                                                 Background="#0AFFFFFF" Foreground="{StaticResource AccentCiano}"
                                                                                 BorderThickness="0" Opacity="0.7"
                                                                                 Visibility="{Binding LinkedSensor, Converter={StaticResource NullToVis}}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding FormattedValue}" FontSize="10"
                                                                               Foreground="{StaticResource AccentPurple}" FontWeight="Black" HorizontalAlignment="Right"/>
                                                                    <TextBlock Text="{Binding LinkedSensor.FormattedValue}" FontSize="9"
                                                                               Foreground="{StaticResource AccentCiano}" FontWeight="Bold"
                                                                               HorizontalAlignment="Right" Opacity="0.8"
                                                                               Visibility="{Binding LinkedSensor, Converter={StaticResource NullToVis}}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LEFT col -->
                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">

                                                    <StackPanel Visibility="{Binding HasClocks, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                        <TextBlock Text="FREQUÊNCIA" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Clocks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="#FFFFFF"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasPower, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                        <TextBlock Text="ENERGIA" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Power}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="{StaticResource AccentCiano}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                        <TextBlock Text="CORRENTE" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Current}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="{StaticResource AccentGreen}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasFactor, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                        <TextBlock Text="OUTROS" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Factor}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="#AAFFFFFF"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasFans, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                        <TextBlock Text="VENTOINHAS" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Fans}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="{StaticResource AccentGreen}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasThroughput, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="THROUGHPUT" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Throughput}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="{StaticResource AccentYellow}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                </StackPanel>

                                                <!-- RIGHT col -->
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0">

                                                    <StackPanel Visibility="{Binding HasTemperatures, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                                        <TextBlock Text="TEMPERATURA" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Temperatures}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="{StaticResource AccentRed}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasVoltages, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="VOLTAGEM" Style="{StaticResource GroupLabel}"/>
                                                        <ItemsControl ItemsSource="{Binding Voltages}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}"           Style="{StaticResource SensorName}"/>
                                                                        <TextBlock Text="{Binding FormattedValue}"  Style="{StaticResource SensorValue}" Foreground="{StaticResource AccentOrange}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                </StackPanel>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
