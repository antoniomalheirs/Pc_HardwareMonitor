<Window x:Class="Monitor_Pc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monitor_Pc"
        xmlns:viewmodels="clr-namespace:Monitor_Pc.ViewModels"
        mc:Ignorable="d"
        Title="MONITOR PRO v4.0" Height="900" Width="1300"
        Background="#08080C" Foreground="#FFFFFF" FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Premium Colors -->
        <SolidColorBrush x:Key="AccentCiano" Color="#00F2FF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#BC00FF"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9E00"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF3D00"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="CardBackground" Color="#12121A"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#0A0A0F"/>

        <!-- Glass Style -->
        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3300F2FF"/>
                    <Setter Property="Background" Value="#161622"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sensor Card Style -->
        <Style x:Key="SensorTile" TargetType="Border">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="Width" Value="180"/>
        </Style>

        <Style x:Key="HeaderIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <Style x:Key="SectionHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#73FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SensorNameLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="170"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SensorValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#55FFFFFF"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10FFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0">
            <Grid Margin="30,50,30,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <StackPanel Margin="0,0,0,60">
                    <Grid HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Ellipse Width="48" Height="48" Fill="{StaticResource AccentPurple}" Opacity="0.15"/>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentCiano}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="MONITOR" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="CORE ENGINE v4" FontSize="11" Foreground="#44FFFFFF" FontWeight="Bold" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="5,0,0,20"/>
                    <Border Background="#12FFFFFF" CornerRadius="14" Padding="20,16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentCiano}" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Status" Margin="20,0,0,0" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status Card -->
                <Border Grid.Row="3" Padding="25" CornerRadius="20" Background="#08FFFFFF" BorderBrush="#08FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SENSORS STATUS" FontSize="9" FontWeight="Black" Foreground="#33FFFFFF" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{Binding Source={StaticResource AccentGreen}, Path=Color}" BlurRadius="12" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ADMIN ACTIVE" Margin="12,0,0,0" FontSize="12" FontWeight="Black" Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1" Background="#08080C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Custom Title Bar Row -->
                <RowDefinition Height="Auto"/> <!-- Header Bar Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR / WINDOW CONTROLS -->
            <Grid Grid.Row="0" Background="#10FFFFFF" Height="32" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="MONITOR PRO v4.0" FontSize="11" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="25,0,0,0" FontWeight="Bold" IsHitTestVisible="False"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource TitleBarButtonStyle}" Content="─"/>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource TitleBarButtonStyle}" Content="▢"/>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- HEADER BAR -->
            <Border Grid.Row="1" Padding="50,30,50,40" Background="#02FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="Performance Hub" FontSize="32" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Advanced processor and graphics analytics" FontSize="14" Foreground="#44FFFFFF" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="25,12" Margin="0,0,20,0" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU LOAD" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding CpuLoad}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentPurple}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="25,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAX THERMAL" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding MaxTemp}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentRed}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT SCROLL -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="40,10,40,40">
                <ItemsControl ItemsSource="{Binding HardwareItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PremiumCard}" Margin="0,0,20,20" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- ITEM HEADER -->
                                    <Border Background="#06FFFFFF" CornerRadius="20,20,0,0" Padding="22,18" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid>
                                                    <Ellipse Width="40" Height="40" Fill="{StaticResource AccentCiano}" Opacity="0.08"/>
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource HeaderIcon}" FontSize="20" Foreground="{StaticResource AccentCiano}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Resumo de sensores em tempo real" FontSize="11" Foreground="#66FFFFFF"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#0DFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HardwareType}" FontSize="10" Foreground="#C8FFFFFF" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- SENSOR LISTS (Pro Table View) -->
                                    <Border Grid.Row="1" Padding="25">
                                        <StackPanel>
                                            

                                            <!-- RESOURCE UTILIZATION (Compact Grid for high core counts) -->
                                            <StackPanel Visibility="{Binding HasLoads, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,30">
                                                <TextBlock Text="Carga / Uso (HWiNFO)" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,14"/>
                                                <ItemsControl ItemsSource="{Binding Loads}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,15,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="42"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#40FFFFFF" Margin="0,0,0,6" FontWeight="Medium"/>
                                                                    <ProgressBar Value="{Binding ValuePercentage}" Height="4" Background="#0AFFFFFF" Foreground="{StaticResource AccentPurple}" BorderThickness="0" Tag="{Binding ValuePercentage}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontSize="11" Foreground="{StaticResource AccentPurple}" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LEFT COLUMN: Physical Stats -->
                                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                    <StackPanel Visibility="{Binding HasClocks, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,25">
                                                        <TextBlock Text="Frequência (HWiNFO)" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,12"/>
                                                        <ItemsControl ItemsSource="{Binding Clocks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SensorNameLabel}" HorizontalAlignment="Left"/>
                                                                        <TextBlock Text="{Binding FormattedValue}" Style="{StaticResource SensorValueLabel}" Foreground="#FFFFFF"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasPower, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,25">
                                                        <TextBlock Text="Consumo de energia" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,12"/>
                                                        <ItemsControl ItemsSource="{Binding Power}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SensorNameLabel}" HorizontalAlignment="Left"/>
                                                                        <TextBlock Text="{Binding FormattedValue}" Style="{StaticResource SensorValueLabel}" Foreground="{StaticResource AccentCiano}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasFans, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Ventoinhas" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,12"/>
                                                        <ItemsControl ItemsSource="{Binding Fans}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SensorNameLabel}" HorizontalAlignment="Left"/>
                                                                        <TextBlock Text="{Binding FormattedValue}" Style="{StaticResource SensorValueLabel}" Foreground="{StaticResource AccentGreen}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- RIGHT COLUMN: Thermal & Electric -->
                                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                                    <StackPanel Visibility="{Binding HasTemperatures, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,25">
                                                        <TextBlock Text="Temperatura (HWiNFO)" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,12"/>
                                                        <ItemsControl ItemsSource="{Binding Temperatures}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SensorNameLabel}" HorizontalAlignment="Left"/>
                                                                        <TextBlock Text="{Binding FormattedValue}" Style="{StaticResource SensorValueLabel}" Foreground="{StaticResource AccentRed}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasVoltages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Voltagem" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,12"/>
                                                        <ItemsControl ItemsSource="{Binding Voltages}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SensorNameLabel}" HorizontalAlignment="Left"/>
                                                                        <TextBlock Text="{Binding FormattedValue}" Style="{StaticResource SensorValueLabel}" Foreground="{StaticResource AccentOrange}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
