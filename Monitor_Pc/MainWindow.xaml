<Window x:Class="Monitor_Pc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Monitor_Pc.ViewModels"
        xmlns:converters="clr-namespace:Monitor_Pc.Converters"
        mc:Ignorable="d"
        Title="MONITOR PRO v5.0" Height="900" Width="1300"
        Background="#08080C" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCiano"       Color="#00F2FF"/>
        <SolidColorBrush x:Key="AccentPurple"      Color="#BC00FF"/>
        <SolidColorBrush x:Key="AccentOrange"      Color="#FF9E00"/>
        <SolidColorBrush x:Key="AccentRed"         Color="#FF3D00"/>
        <SolidColorBrush x:Key="AccentGreen"       Color="#00E676"/>
        <SolidColorBrush x:Key="AccentYellow"      Color="#FFE57F"/>
        <SolidColorBrush x:Key="CardBackground"    Color="#12121A"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#0A0A0F"/>

        <converters:NullToVisibilityConverter   x:Key="NullToVis"/>
        <converters:PercentToWidthConverter      x:Key="PctToWidth"/>
        <converters:StringToVisibilityConverter  x:Key="StrToVis"/>
        <BooleanToVisibilityConverter            x:Key="BoolToVis"/>

        <!-- Converter for inverse bool: shows diagnostic panel only when HWiNFO is NOT active -->
        <Style x:Key="DiagPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HwInfoActive}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush"     Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="20"/>
            <Setter Property="Margin"          Value="0,0,20,20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3300F2FF"/>
                    <Setter Property="Background"  Value="#161622"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#44FFFFFF"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SensorName" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#BFFFFFFF"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth"          Value="210"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SensorValue" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#55FFFFFF"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10FFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TBtnClose" BasedOn="{StaticResource TBtn}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,50,28,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>  <!-- alerts -->
                        <RowDefinition Height="Auto"/>  <!-- readings -->
                        <RowDefinition Height="Auto"/>  <!-- logger -->
                        <RowDefinition Height="Auto"/>  <!-- diagnostic -->
                        <RowDefinition Height="Auto"/>  <!-- data source -->
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                        <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Ellipse Width="48" Height="48" Fill="{StaticResource AccentPurple}" Opacity="0.15"/>
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="{StaticResource AccentCiano}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="MONITOR" FontSize="22" FontWeight="Black"/>
                        <TextBlock Text="CORE ENGINE v5" FontSize="11" Foreground="#44FFFFFF" FontWeight="Bold" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,30">
                        <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="5,0,0,14"/>
                        <Border Background="#12FFFFFF" CornerRadius="14" Padding="18,14"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentCiano}" VerticalAlignment="Center"/>
                                <TextBlock Text="Live Status" Margin="16,0,0,0" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Stats (only when HWiNFO active) -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,20"
                                Visibility="{Binding HwInfoActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="READINGS" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="5,0,0,12"/>
                        <Border Background="#08FFFFFF" CornerRadius="14" Padding="18,12"
                                BorderBrush="#10FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalReadings}" FontSize="28" FontWeight="Black"
                                           Foreground="{StaticResource AccentCiano}" HorizontalAlignment="Center"/>
                                <TextBlock Text="sensores ativos" FontSize="10" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#08FFFFFF" CornerRadius="14" Padding="18,12"
                                BorderBrush="#10FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding LastUpdate}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="última leitura" FontSize="10" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ ALERT PANEL ═══════════════════════════════════ -->
                    <Border Grid.Row="2" Margin="0,0,0,20" Padding="18,14" CornerRadius="14"
                            BorderThickness="1"
                            Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <SolidColorBrush Color="#1AFF5252"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#44FF5252"/>
                        </Border.BorderBrush>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="10" Height="10" Fill="#FF5252" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF5252" BlurRadius="12" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="  ALERTAS" FontSize="10" FontWeight="Black"
                                           Foreground="#FF5252" VerticalAlignment="Center"/>
                                <Border Background="#33FF5252" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding AlertCount}" FontSize="10" FontWeight="Black"
                                               Foreground="#FF5252"/>
                                </Border>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ActiveAlerts}" MaxHeight="200">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#08FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SensorName}" FontSize="9" Foreground="#AAFFFFFF"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="10" FontWeight="Bold"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding SeverityColor}"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ LOGGER CONTROLS ═══════════════════════════════════ -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="LOGGER" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="5,0,0,12"/>
                        <Border Background="#08FFFFFF" CornerRadius="14" Padding="18,14"
                                BorderBrush="#10FFFFFF" BorderThickness="1">
                            <StackPanel>

                                <!-- Interval selector -->
                                <TextBlock Text="INTERVALO" FontSize="9" FontWeight="Black" Foreground="#22FFFFFF" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Command="{Binding SetIntervalCommand}" CommandParameter="500" Margin="0,0,4,0"
                                            Height="24" Padding="8,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#08FFFFFF"/>
                                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#10FFFFFF"/>
                                                <Setter Property="Content" Value="0.5s"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A00F2FF"/>
                                                        <Setter Property="Foreground" Value="#00F2FF"/>
                                                        <Setter Property="BorderBrush" Value="#3300F2FF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding UpdateIntervalMs}" Value="500">
                                                        <Setter Property="Background" Value="#3300F2FF"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#00F2FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetIntervalCommand}" CommandParameter="1000" Margin="0,0,4,0"
                                            Height="24" Padding="8,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#1A00F2FF"/>
                                                <Setter Property="Foreground" Value="#00F2FF"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#3300F2FF"/>
                                                <Setter Property="Content" Value="1s"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3300F2FF"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding UpdateIntervalMs}" Value="1000">
                                                        <Setter Property="Background" Value="#3300F2FF"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#00F2FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetIntervalCommand}" CommandParameter="2000" Margin="0,0,4,0"
                                            Height="24" Padding="8,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#08FFFFFF"/>
                                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#10FFFFFF"/>
                                                <Setter Property="Content" Value="2s"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A00F2FF"/>
                                                        <Setter Property="Foreground" Value="#00F2FF"/>
                                                        <Setter Property="BorderBrush" Value="#3300F2FF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding UpdateIntervalMs}" Value="2000">
                                                        <Setter Property="Background" Value="#3300F2FF"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#00F2FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetIntervalCommand}" CommandParameter="5000"
                                            Height="24" Padding="8,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#08FFFFFF"/>
                                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#10FFFFFF"/>
                                                <Setter Property="Content" Value="5s"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A00F2FF"/>
                                                        <Setter Property="Foreground" Value="#00F2FF"/>
                                                        <Setter Property="BorderBrush" Value="#3300F2FF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding UpdateIntervalMs}" Value="5000">
                                                        <Setter Property="Background" Value="#3300F2FF"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#00F2FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Reset min/max button -->
                                <Button Command="{Binding ResetAllStatisticsCommand}" Margin="0,0,0,12"
                                        Height="24" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#08FFFFFF"/>
                                            <Setter Property="Foreground" Value="#55FFFFFF"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Content" Value="🔄  RESET MIN/MAX"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="8,4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                    <Setter Property="Foreground" Value="#AAFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                <!-- Status indicator + Toggle -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Recording dot -->
                                    <Ellipse x:Name="RecDot" Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#44FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogging}" Value="True">
                                                        <Setter Property="Fill" Value="#FF3D00"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FF3D00" BlurRadius="14" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Grid.Column="1" Text="{Binding LoggingStatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Toggle button -->
                                    <Button Grid.Column="2" Command="{Binding ToggleLoggingCommand}"
                                            Height="28" Padding="14,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#1A00E676"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="FontWeight" Value="Black"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#3300E676"/>
                                                <Setter Property="Content" Value="⏺ INICIAR LOG"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogging}" Value="True">
                                                        <Setter Property="Content" Value="⏹ PARAR LOG"/>
                                                        <Setter Property="Background" Value="#1AFF3D00"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                        <Setter Property="BorderBrush" Value="#33FF3D00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Entry count -->
                                <Border Background="#06FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                        Visibility="{Binding IsLogging, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Entradas: " FontSize="10" Foreground="#55FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LogEntryCount}" FontSize="14" FontWeight="Black"
                                                   Foreground="{StaticResource AccentCiano}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- File path -->
                                <TextBlock Text="{Binding LogFilePath}" FontSize="9" Foreground="#33FFFFFF"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"
                                           Visibility="{Binding IsLogging, Converter={StaticResource BoolToVis}}"/>

                                <!-- Open folder button -->
                                <Button Command="{Binding OpenLogFolderCommand}" Margin="0,8,0,0"
                                        Height="26" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#08FFFFFF"/>
                                            <Setter Property="Foreground" Value="#66FFFFFF"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Content" Value="📂  ABRIR PASTA DE LOGS"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="8,4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                    <Setter Property="Foreground" Value="#AAFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Text="{Binding ExportStatusText}" Foreground="#22C55E" Margin="0,8,0,0"
                                           FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                                <Button Command="{Binding ExportToExcelCommand}" Margin="0,4,0,0"
                                        Height="32" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#1A22C55E"/>
                                            <Setter Property="Foreground" Value="#22C55E"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#4022C55E"/>
                                            <Setter Property="Content" Value="📊  EXPORTAR PARA EXCEL"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3322C55E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#22C55E"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Dump all sensors to file -->
                                <Button Command="{Binding DumpSensorsCommand}" Margin="0,8,0,0"
                                        Height="26" HorizontalAlignment="Stretch"
                                        Visibility="{Binding HwInfoActive, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#08FFFFFF"/>
                                            <Setter Property="Foreground" Value="#44FFFFFF"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Content" Value="🔍  DUMP SENSORES"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="8,4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                    <Setter Property="Foreground" Value="#AAFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ⚠️ Diagnostic panel — shows ONLY when HWiNFO is not connected -->
                    <Border Grid.Row="5" Style="{StaticResource DiagPanel}"
                            Margin="0,0,0,20" Padding="18,16" CornerRadius="16"
                            Background="#1AFF9E00" BorderBrush="#44FF9E00" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                                <TextBlock Text="  DIAGNÓSTICO" FontSize="10" FontWeight="Black"
                                           Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DiagnosticMessage}"
                                       FontSize="11" Foreground="#CCFF9E00"
                                       TextWrapping="Wrap" LineHeight="18"/>
                            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="10"
                                    Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
                                <TextBlock FontSize="10" Foreground="#AAFFFFFF" TextWrapping="Wrap" LineHeight="16">
                                    <Run FontWeight="Bold" Foreground="#FFFFFF">Como corrigir:</Run>
                                    <LineBreak/>
                                    1. Abra o HWiNFO64
                                    <LineBreak/>
                                    2. Clique no ícone de engrenagem (Settings)
                                    <LineBreak/>
                                    3. Aba "General"
                                    <LineBreak/>
                                    4. Marque "Shared Memory Support"
                                    <LineBreak/>
                                    5. Clique OK
                                    <LineBreak/>
                                    6. Feche e reabra os Sensores
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Data source indicator -->
                    <Border Grid.Row="6" Padding="20,18" CornerRadius="20"
                            Background="#08FFFFFF" BorderBrush="#08FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DATA SOURCE" FontSize="9" FontWeight="Black" Foreground="#33FFFFFF" Margin="0,0,0,10"/>

                            <!-- HWiNFO active -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HwInfoActive, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00E676" BlurRadius="12" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="HWiNFO64 ATIVO" Margin="12,0,0,0" FontSize="12"
                                           FontWeight="Black" Foreground="{StaticResource AccentGreen}"/>
                            </StackPanel>

                            <!-- Fallback -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HwInfoActive}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                                <TextBlock Text="MODO FALLBACK" Margin="12,0,0,0" FontSize="12"
                                           FontWeight="Black" Foreground="{StaticResource AccentOrange}"/>
                            </StackPanel>

                            <!-- Last update (always visible) -->
                            <TextBlock Text="{Binding LastUpdate}" FontSize="11"
                                       Foreground="#33FFFFFF" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ═══ MAIN ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="#08080C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#10FFFFFF" Height="32"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="MONITOR PRO v5.0" FontSize="11" Foreground="#44FFFFFF"
                           VerticalAlignment="Center" Margin="25,0,0,0" FontWeight="Bold" IsHitTestVisible="False"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource TBtn}"      Content="─"/>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource TBtn}"      Content="▢"/>
                    <Button x:Name="BtnClose"    Click="BtnClose_Click"    Style="{StaticResource TBtnClose}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- Header bar -->
            <Border Grid.Row="1" Padding="50,30,50,40" Background="#02FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Performance Hub" FontSize="32" FontWeight="SemiBold"/>
                        <TextBlock FontSize="14" Foreground="#44FFFFFF" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="HWiNFO64 · dados em tempo real · todos os sensores"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HwInfoActive}" Value="False">
                                            <Setter Property="Text" Value="Modo fallback · ative o Shared Memory no HWiNFO64"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="22,12" Margin="0,0,14,0" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CpuLoad}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentPurple}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="22,12" Margin="0,0,14,0" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TEMP" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding MaxTemp}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentRed}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0DFFFFFF" CornerRadius="16" Padding="22,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM" FontSize="10" FontWeight="Black" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding RamUsage}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentCiano}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ SENSOR CARDS ════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="40,10,20,40">
                <ItemsControl ItemsSource="{Binding HardwareItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Main Hardware Header -->
                                    <Border Background="#06FFFFFF" CornerRadius="20,20,0,0"
                                            Padding="22,16" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <Ellipse Width="38" Height="38" Fill="{StaticResource AccentCiano}" Opacity="0.08"/>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                           Foreground="{StaticResource AccentCiano}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sensor Categories Array -->
                                    <Border Grid.Row="1" Padding="22,16">
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <!-- Layout of categories: wrap nicely -->
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" ItemWidth="300" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,30,20">
                                                        
                                                        <!-- Category Label (e.g. Frequências) -->
                                                        <Border Background="#0DFFFFFF" CornerRadius="4" Padding="8,4" Margin="0,0,0,12" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold">
                                                                <TextBlock.Foreground>
                                                                    <SolidColorBrush Color="{Binding AccentColor}"/>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </Border>
                                                    
                                                        <!-- Category Sensors -->
                                                        <ItemsControl ItemsSource="{Binding Sensors}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="150"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Sensor name -->
                                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                                   Text="{Binding Name}" Style="{StaticResource SensorName}"
                                                                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="140"/>

                                                                        <!-- Sensor value with alert color -->
                                                                        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FormattedValue}" FontWeight="Bold">
                                                                                <TextBlock.Foreground>
                                                                                    <SolidColorBrush Color="{Binding DataContext.AccentColor, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"/>
                                                                                </TextBlock.Foreground>
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SensorValue}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding AlertLevel}" Value="Critical">
                                                                                                <Setter Property="Foreground" Value="#FF5252"/>
                                                                                                <Setter Property="Effect">
                                                                                                    <Setter.Value>
                                                                                                        <DropShadowEffect Color="#FF5252" BlurRadius="8" ShadowDepth="0"/>
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding AlertLevel}" Value="Warning">
                                                                                                <Setter Property="Foreground" Value="#FFD740"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <!-- Progress bar (only for temp/load/fan) -->
                                                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                                Height="4" CornerRadius="2" Margin="0,4,0,0"
                                                                                Background="#10FFFFFF"
                                                                                Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}">
                                                                            <Border HorizontalAlignment="Left" CornerRadius="2" Height="4"
                                                                                    Width="{Binding ProgressPercent, Converter={StaticResource PctToWidth}}">
                                                                                <Border.Background>
                                                                                    <SolidColorBrush Color="{Binding ProgressColor}"/>
                                                                                </Border.Background>
                                                                            </Border>
                                                                        </Border>

                                                                        <!-- Min/Max display -->
                                                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                                                   Text="{Binding FormattedMinMax}"
                                                                                   FontSize="9" Foreground="#33FFFFFF" Margin="0,2,0,0"
                                                                                   Visibility="{Binding FormattedMinMax, Converter={StaticResource StrToVis}}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
